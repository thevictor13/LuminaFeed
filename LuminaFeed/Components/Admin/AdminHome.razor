@page "/admin"
@attribute [Authorize(Policy = AdminAuthorization.PolicyName)]

<PageTitle>Admin</PageTitle>

<h1>Admin</h1>

<p>Welcome to the LuminaFeed admin area.</p>

<ul>
    <li><a href="admin/categories">Categories</a> — add and list feed categories.</li>
    <li><a href="admin/feeds">Feeds</a> — add and list the curated RSS feeds.</li>
    <li><a href="admin/users">Users</a> — list users and their subscriptions; remove subscriptions or delete registrations.</li>
</ul>
