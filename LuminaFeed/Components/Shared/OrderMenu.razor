@* The public list's per-category order control (B2). A thin wrapper over the shared DropdownMenu: the four
   FeedOrder options as menu items, the current one marked active. The parent (CategorySection) owns the state. *@
<DropdownMenu TriggerText="Order" AriaLabel="@($"Order {Label} by")" MenuEnd="true" Class="order-menu">
    @foreach (var option in Options)
    {
        <button type="button" role="menuitem"
                class="dropdown-item @(option == Value ? "active" : null)"
                aria-current="@(option == Value ? "true" : null)"
                @onclick="@(() => SelectAsync(context, option))">
            @FeedOrdering.Label(option)
        </button>
    }
</DropdownMenu>

@code {
    private static readonly FeedOrder[] Options = Enum.GetValues<FeedOrder>();

    [Parameter] public FeedOrder Value { get; set; }
    [Parameter] public EventCallback<FeedOrder> OnChange { get; set; }

    /// <summary>Names the control for assistive tech (e.g. the category it orders).</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = default!;

    private async Task SelectAsync(DropdownMenu.DropdownContext context, FeedOrder option)
    {
        await context.Close.InvokeAsync();
        if (option != Value)
            await OnChange.InvokeAsync(option);
    }
}
