@* A minimal Bootstrap modal driven entirely by Blazor state. Only Bootstrap's CSS is loaded (no bootstrap.js),
   so the dialog is plain conditionally-rendered markup — it stays inside the SignalR circuit and is bUnit-testable.
   Rendered only while Visible; the caller supplies the body (an edit form or a confirmation) as ChildContent, and
   optional action buttons as Footer. The backdrop is static (clicking it does not close the dialog) so an in-progress
   edit isn't lost by a stray click, but Escape closes it (an intentional keypress, not a stray click) — unless
   CloseDisabled is set (e.g. mid-save), which also disables the header close button. Focus moves in when it opens.

   Scope note: on close, focus is not programmatically returned to the invoking control. Doing that would need either
   the trigger's ElementReference — which the callers render inside a @foreach, where Blazor can't capture a per-row
   ref, and which no longer exists after a delete removes its row — or reading document.activeElement through custom
   JS interop, which this component deliberately avoids so it stays inside the circuit and bUnit-testable. Focus-in
   (the WCAG-critical half) is handled; focus-return is intentionally left out. Tab is likewise not trapped. *@

@if (Visible)
{
    <div class="modal d-block show" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="@titleId"
         @ref="dialog" @onkeydown="OnKeyDown">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 id="@titleId" class="modal-title h5">@Title</h2>
                    <button type="button" class="btn-close" aria-label="Close" disabled="@CloseDisabled"
                            @onclick="() => OnClose.InvokeAsync()"></button>
                </div>
                <div class="modal-body">
                    @ChildContent
                </div>
                @if (Footer is not null)
                {
                    <div class="modal-footer">
                        @Footer
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private readonly string titleId = $"modal-title-{Guid.NewGuid():N}";
    private ElementReference dialog;
    private bool wasVisible;
    private bool focusOnRender;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional action buttons rendered in the modal footer (e.g. Save / Cancel / a destructive action).</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>When set, the header close button is disabled and Escape does not close the dialog (e.g. a save in flight).</summary>
    [Parameter] public bool CloseDisabled { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    protected override void OnParametersSet()
    {
        // Focus the dialog on the first render after it opens, so keyboard users land inside it and Escape
        // (handled on the container, tabindex="-1") works immediately.
        if (Visible && !wasVisible)
            focusOnRender = true;
        wasVisible = Visible;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusOnRender)
        {
            focusOnRender = false;
            await dialog.FocusAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !CloseDisabled)
            await OnClose.InvokeAsync();
    }
}
