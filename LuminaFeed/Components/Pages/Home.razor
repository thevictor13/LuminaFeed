@page "/"
@rendermode InteractiveServer

@using System.Security.Claims
@using LuminaFeed.Services.Feeds
@using LuminaFeed.Services.Subscriptions

@inject IFeedService FeedService
@inject ISubscriptionService SubscriptionService
@inject NavigationManager NavigationManager

<PageTitle>LuminaFeed</PageTitle>

<h1>Feeds</h1>

<p class="lead">Subscribe to curated RSS feeds and get alerted by email when they publish something new.</p>

<ErrorList Messages="errors"/>

@if (Categories is null)
{
    <p><em>Loading…</em></p>
}
else if (Categories.Count == 0)
{
    <p>No feeds have been added yet.</p>
}
else
{
    <div class="mb-4">
        <CategoryFilter Options="filterOptions" Selected="selectedCategoryId" OnChange="OnFilterChanged"/>
    </div>

    @foreach (var category in VisibleCategories)
    {
        <CategorySection Category="category"
                         PageSize="@(selectedCategoryId is null ? DefaultPageSize : FilteredPageSize)"
                         IsAuthenticated="@(userId is not null)"
                         LoginUrl="@loginUrl"
                         SubscribedFeedIds="SubscribedFeedIds"
                         OnOpenDialog="OpenDialog"
                         @key="category.CategoryId"/>
    }
}

@if (userId is not null && openFeed is not null)
{
    <SubscribeDialog FeedId="openFeed.Id"
                     FeedName="@openFeed.Name"
                     UserId="@userId"
                     AccountEmail="@accountEmail"
                     Visible="true"
                     OnChanged="OnDialogChanged"
                     OnClose="CloseDialog"/>
}

@code {
    // The main view shows 5 cards per category; the B3 category filter narrows the page to one category, 30 deep.
    private const int DefaultPageSize = 5;
    private const int FilteredPageSize = 30;

    private string? userId;
    private string? accountEmail;
    private string loginUrl = "Account/Login";
    private FeedSummary? openFeed;
    private IReadOnlyList<string> errors = [];

    // The selected category filter (B3). Ephemeral, like the per-section paging/order — not persisted across the
    // circuit hand-off; null means "All feeds".
    private Guid? selectedCategoryId;

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    // The catalogue is deliberately NOT persisted across the prerender → circuit hand-off: persisted state travels
    // back to the server inside the circuit-start message, which SignalR caps at 32 KB, and 115 feed summaries
    // came to ~87 KB — the circuit died on every page load and nothing was ever interactive. One fast query on
    // the interactive render is the right price; PublicPagesTests keeps the persisted payload small.
    private IReadOnlyList<CategoryFeeds>? Categories { get; set; }

    // The user's subscribed feed ids are small (one Guid each) and worth carrying over, so the buttons don't flip.
    [PersistentState] public HashSet<Guid>? SubscribedIds { get; set; }

    private HashSet<Guid> SubscribedFeedIds => SubscribedIds ??= [];

    // Filter options come from the already-loaded catalogue — built once when it loads (below), so no fresh list is
    // allocated per render and the CategoryFilter's Options parameter keeps a stable identity.
    private IReadOnlyList<(Guid Id, string Name)> filterOptions = [];

    // "All feeds" shows every category; a selection narrows to the one (if it still exists).
    private IReadOnlyList<CategoryFeeds> VisibleCategories =>
        Categories is null
            ? []
            : selectedCategoryId is { } id
                ? [.. Categories.Where(c => c.CategoryId == id)]
                : Categories;

    protected override async Task OnInitializedAsync()
    {
        // The id always comes from the authenticated principal — never from anything the client sends.
        if (AuthenticationState is not null)
        {
            var user = (await AuthenticationState).User;
            if (user.Identity?.IsAuthenticated == true)
            {
                userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
                // The (fixed) email target shown in the dialog; the username equals the address for this app.
                accountEmail = user.FindFirstValue(ClaimTypes.Email) ?? user.Identity.Name;
            }
        }

        // Anonymous visitors are treated as having no subscriptions; "Subscribe" sends them to log in and back.
        loginUrl = NavigationManager.GetUriWithQueryParameters(
            "Account/Login",
            new Dictionary<string, object?> { ["ReturnUrl"] = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri) });

        Categories = await FeedService.ListByCategoryAsync();
        filterOptions = [.. Categories.Select(c => (c.CategoryId, c.CategoryName))];
        SubscribedIds ??= [.. await SubscriptionService.GetSubscribedFeedIdsAsync(userId)];
    }

    private void OnFilterChanged(Guid? categoryId) => selectedCategoryId = categoryId;

    // Both Subscribe and the red Unsubscribe (rendered by CategorySection) open the same channel dialog; it owns the
    // service calls and its own in-flight state, and reports back which channels the user ended on.
    private void OpenDialog(FeedSummary feed) => openFeed = feed;

    private void CloseDialog() => openFeed = null;

    private void OnDialogChanged(bool subscribed)
    {
        if (openFeed is null)
            return;

        // Replace the set rather than mutate it in place, so the CategorySection children re-render with the feed's
        // new red/primary state (a same-reference mutation would not reliably reach them).
        var next = new HashSet<Guid>(SubscribedFeedIds);
        if (subscribed)
            next.Add(openFeed.Id);
        else
            next.Remove(openFeed.Id);
        SubscribedIds = next;
    }
}
