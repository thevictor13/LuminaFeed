@page "/"
@rendermode InteractiveServer

@using System.Security.Claims
@using LuminaFeed.Services.Feeds
@using LuminaFeed.Services.Subscriptions

@inject IFeedService FeedService
@inject ISubscriptionService SubscriptionService
@inject NavigationManager NavigationManager

<PageTitle>LuminaFeed</PageTitle>

<h1>Feeds</h1>

<p class="lead">Subscribe to curated RSS feeds and get alerted by email when they publish something new.</p>

<ErrorList Messages="errors"/>

@if (Categories is null)
{
    <p><em>Loading…</em></p>
}
else if (Categories.Count == 0)
{
    <p>No feeds have been added yet.</p>
}
else
{
    @foreach (var category in Categories)
    {
        <CategorySection Category="category"
                         IsAuthenticated="@(userId is not null)"
                         LoginUrl="@loginUrl"
                         SubscribedFeedIds="SubscribedFeedIds"
                         BusyFeedId="busyFeedId"
                         OnToggleSubscription="ToggleSubscriptionAsync"
                         @key="category.CategoryId"/>
    }
}

@code {
    private string? userId;
    private string loginUrl = "Account/Login";
    private Guid? busyFeedId;
    private IReadOnlyList<string> errors = [];

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    // The catalogue is deliberately NOT persisted across the prerender → circuit hand-off: persisted state travels
    // back to the server inside the circuit-start message, which SignalR caps at 32 KB, and 115 feed summaries
    // came to ~87 KB — the circuit died on every page load and nothing was ever interactive. One fast query on
    // the interactive render is the right price; PublicPagesTests keeps the persisted payload small.
    private IReadOnlyList<CategoryFeeds>? Categories { get; set; }

    // The user's subscribed feed ids are small (one Guid each) and worth carrying over, so the buttons don't flip.
    [PersistentState] public HashSet<Guid>? SubscribedIds { get; set; }

    private HashSet<Guid> SubscribedFeedIds => SubscribedIds ??= [];

    protected override async Task OnInitializedAsync()
    {
        // The id always comes from the authenticated principal — never from anything the client sends.
        if (AuthenticationState is not null)
        {
            var user = (await AuthenticationState).User;
            userId = user.Identity?.IsAuthenticated == true ? user.FindFirstValue(ClaimTypes.NameIdentifier) : null;
        }

        // Anonymous visitors are treated as having no subscriptions; "Subscribe" sends them to log in and back.
        loginUrl = NavigationManager.GetUriWithQueryParameters(
            "Account/Login",
            new Dictionary<string, object?> { ["ReturnUrl"] = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri) });

        Categories = await FeedService.ListByCategoryAsync();
        SubscribedIds ??= [.. await SubscriptionService.GetSubscribedFeedIdsAsync(userId)];
    }

    private async Task ToggleSubscriptionAsync(Guid feedId)
    {
        if (userId is null || busyFeedId is not null)
            return;

        busyFeedId = feedId;
        try
        {
            errors = [];
            if (SubscribedFeedIds.Contains(feedId))
            {
                var result = await SubscriptionService.UnsubscribeAsync(userId, feedId);
                // Already gone (e.g. removed in another tab) is the state the user asked for.
                if (!result.IsError || result.FirstError.Code == SubscriptionErrors.NotSubscribed.Code)
                    SubscribedFeedIds.Remove(feedId);
                else
                    errors = [.. result.Errors.Select(e => e.Description)];
            }
            else
            {
                var result = await SubscriptionService.SubscribeByEmailAsync(userId, feedId);
                if (!result.IsError)
                    SubscribedFeedIds.Add(feedId);
                else
                    errors = [.. result.Errors.Select(e => e.Description)];
            }
        }
        finally
        {
            busyFeedId = null;
        }
    }
}
